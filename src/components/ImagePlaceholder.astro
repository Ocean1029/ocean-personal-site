---
import { imagePlaceholderLabel } from '../lib/image-placeholder';

interface Props {
  label: string;
  lang?: 'zh' | 'en';
  class?: string;
}

const { label, lang = 'zh', class: className } = Astro.props;
const placeholderLabel = imagePlaceholderLabel(label, lang);
---

<div class:list={['image-placeholder', className]} role="img" aria-label={placeholderLabel}>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <rect x="3" y="4" width="18" height="16" rx="2" />
    <circle cx="8.5" cy="9" r="1.5" />
    <path d="m5 18 5.5-5 3.5 3 2.5-2 2.5 4" />
  </svg>
  <span>{placeholderLabel}</span>
</div>
