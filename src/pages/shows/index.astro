---
import { getCollection } from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import ImagePlaceholder from '../../components/ImagePlaceholder.astro'; import PageIntro from '../../components/PageIntro.astro'; import { pageIntro } from '../../lib/page-intro'; import { publishedEntries } from '../../lib/published'; import { sortByPublication } from '../../lib/collection';
const entries=sortByPublication(publishedEntries((await getCollection('shows')).map(({data})=>data))); const labels=[...new Set(entries.flatMap((entry)=>entry.genres))].sort();
---
<BaseLayout title="觀影 | Ocean"><PageIntro {...pageIntro('screenings')} /><div class="collection-tools"><select><option>TV</option><option>Movie</option><option>Book</option></select><select><option>不限評分</option>{labels.map((label)=><option>{label}</option>)}</select><input type="search" placeholder="Search by title..."/></div><div class="poster-grid">{entries.map((entry)=><article class="poster"><ImagePlaceholder label={`${entry.title} 海報`} class="poster-image" /><span class="rating">★ {entry.rating.toFixed(1)}</span><h2>{entry.title}</h2></article>)}<article class="poster"><ImagePlaceholder label="下一部海報" class="poster-image" /><span class="rating">★ 4.5</span><h2>下一部，還沒決定</h2></article><article class="poster"><ImagePlaceholder label="待補收藏海報" class="poster-image" /><span class="rating">★ 5.0</span><h2>待補上的收藏</h2></article></div></BaseLayout>
