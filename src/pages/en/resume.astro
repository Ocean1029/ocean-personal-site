---
import BaseLayout from '../../layouts/BaseLayout.astro';
const resumeUrl = `${import.meta.env.BASE_URL}media/ocean-resume-placeholder.pdf`;
---
<BaseLayout title="Resume | Ocean" lang="en"><div class="page-title page-intro"><p class="kicker">Resume</p><p class="work-intro">A concise record of experience, direction, and the work I am continuing to build.</p></div><article class="prose"><p>English resume placeholder.</p><a class="button" href={resumeUrl} download>Download PDF resume</a></article></BaseLayout>
