---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { assertUniqueCocktailSlugs, filterCocktails } from '../../lib/cocktails';
import { publishedEntries } from '../../lib/published';
import '../../styles/cocktails.css';
const entries = publishedEntries((await getCollection('cocktails')).map(({ data }) => data));
assertUniqueCocktailSlugs(entries);
const cocktails = filterCocktails(entries, {});
const spirits = [...new Set(cocktails.map((entry) => entry.spirit))].sort();
---
<BaseLayout title="調酒圖鑑 | Ocean"><section class="cocktail-book"><header class="cocktail-heading"><p>Drink List</p><h1>調酒圖鑑</h1><span>把喝過、想重做的味道留下來。</span></header><div class="cocktail-filters" aria-label="調酒篩選"><div><button type="button" data-style="" aria-pressed="true">全部</button><button type="button" data-style="classic" aria-pressed="false">經典</button><button type="button" data-style="improvisation" aria-pressed="false">即興</button></div><select data-spirit aria-label="依基酒篩選"><option value="">所有基酒</option>{spirits.map((spirit) => <option value={spirit}>{spirit}</option>)}</select><input data-query type="search" placeholder="搜尋" aria-label="搜尋調酒"/><button class="clear-filter" type="button" data-clear>清除</button></div><div class="cocktail-list" data-grid>{cocktails.map((entry, index) => <a class="cocktail-row" href={`/cocktails/${entry.slug}/`} data-card data-style={entry.style} data-spirit={entry.spirit} data-search={[entry.title, entry.spirit, ...entry.tags].join(' ').toLowerCase()}><div class="cocktail-row-image">{entry.image ? <img src={entry.image.src} alt={entry.image.alt} loading={index === 0 ? 'eager' : 'lazy'} onerror="this.replaceWith(Object.assign(document.createElement('div'), {className: 'cocktail-image-fallback', textContent: '圖片待補'}))"/> : <ImagePlaceholder label={entry.title} class="cocktail-image"/>}</div><div class="cocktail-row-copy"><span class:list={['cocktail-style', entry.style, entry.isVariation && 'variation']}>{entry.style === 'classic' ? entry.isVariation ? '經典變體' : '經典' : '即興'}</span><h2>{entry.title}</h2><p>{entry.notes}</p><small>{entry.spirit}　/　{'★'.repeat(Math.round(entry.rating))}</small></div><span class="cocktail-row-arrow">↗</span></a>)}</div><p class="cocktail-empty" data-empty hidden>找不到符合的調酒。<button type="button" data-clear>清除篩選</button></p></section></BaseLayout>
<script is:inline>
  const root=document.querySelector('.cocktail-book'); if(root){const buttons=[...root.querySelectorAll('button[data-style]')], spirit=root.querySelector('[data-spirit]'), query=root.querySelector('[data-query]'), cards=[...root.querySelectorAll('[data-card]')], empty=root.querySelector('[data-empty]'); const params=new URLSearchParams(location.search); let style=params.get('style')||'', currentSpirit=params.get('spirit')||'', currentQuery=params.get('q')||''; spirit.value=currentSpirit; query.value=currentQuery; const sync=()=>{const url=new URL(location.href); style?url.searchParams.set('style',style):url.searchParams.delete('style'); currentSpirit?url.searchParams.set('spirit',currentSpirit):url.searchParams.delete('spirit'); currentQuery?url.searchParams.set('q',currentQuery):url.searchParams.delete('q'); history.replaceState({},'',url);buttons.forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.style===style)));let count=0;cards.forEach(card=>{const ok=(!style||card.dataset.style===style)&&(!currentSpirit||card.dataset.spirit===currentSpirit)&&(!currentQuery||card.dataset.search.includes(currentQuery.toLowerCase()));card.hidden=!ok;if(ok)count++});empty.hidden=Boolean(count)};buttons.forEach(b=>b.addEventListener('click',()=>{style=b.dataset.style||'';sync()}));spirit.addEventListener('change',()=>{currentSpirit=spirit.value;sync()});query.addEventListener('input',()=>{currentQuery=query.value.trim();sync()});root.querySelectorAll('[data-clear]').forEach(b=>b.addEventListener('click',()=>{style='';currentSpirit='';currentQuery='';spirit.value='';query.value='';sync()}));sync()}
</script>
