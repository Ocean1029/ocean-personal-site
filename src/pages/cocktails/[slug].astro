---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import { assertUniqueCocktailSlugs } from '../../lib/cocktails';
import { publishedEntries } from '../../lib/published';

export async function getStaticPaths() {
  const all = await getCollection('cocktails');
  const entries = all.filter((entry) => publishedEntries([entry.data]).length === 1);
  assertUniqueCocktailSlugs(entries.map((entry) => entry.data));
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { data: entry.data, body: entry.body } }));
}

const { data, body } = Astro.props as { data: any; body?: string };
---
<BaseLayout title={`${data.title} | 調酒圖鑑`}><article class="cocktail-detail"><a class="back-link" href="/cocktails/">← 回到調酒圖鑑</a><div class="detail-hero">{data.image ? <img src={data.image.src} alt={data.image.alt}/> : <ImagePlaceholder label={data.title} class="detail-image"/>}<div><span class:list={['cocktail-style',data.style,data.isVariation&&'variation']}>{data.style==='classic'?data.isVariation?'經典變體':'經典':'即興'}</span><h1>{data.title}</h1><p>{data.spirit} · {'★'.repeat(Math.round(data.rating))}</p>{data.baseClassic && <p>基底經典：{data.baseClassic}</p>}</div></div><div class="detail-grid"><section><h2>材料與比例</h2><ul>{data.ingredients.map((item: any) => <li>{item.ingredient}<span>{item.amount && item.unit ? `${item.amount} ${item.unit}` : '適量'}</span></li>)}</ul></section><section><h2>做法</h2><p>{data.method}</p><p class="detail-date">{data.tastedOn}</p></section></div><section class="detail-notes"><h2>筆記</h2><p>{data.notes}</p>{body && <p>{body}</p>}</section></article></BaseLayout>
